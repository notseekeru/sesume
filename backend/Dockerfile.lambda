FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

RUN npm run build && npm prune --omit=dev

FROM public.ecr.aws/lambda/nodejs:22 AS prod

# The preview compiles LaTeX inside the function (src/latex.ts), and the Lambda base image is Amazon
# Linux 2023, so the engine comes from the distribution rather than the Alpine set in Dockerfile.
RUN microdnf install -y texlive-latex texlive-geometry texlive-hyperref texlive-lm texlive-ec texlive-enumitem texlive-titlesec \
    && microdnf clean all \
    && rm -rf /usr/share/texlive/texmf-dist/doc /usr/share/texlive/texmf-dist/source

# Guards the preamble in frontend/src/lib/toLatex.ts: a package added there and absent here fails
# this build instead of the preview.
RUN printf '%s\n' \
        '\documentclass[10pt,letterpaper]{article}' \
        '\usepackage[margin=0.75in]{geometry}' \
        '\usepackage[T1]{fontenc}' \
        '\usepackage{lmodern}' \
        '\usepackage{enumitem}' \
        '\usepackage{titlesec}' \
        '\usepackage[hidelinks]{hyperref}' \
        '\begin{document}x\end{document}' > /tmp/preamble.tex \
    && pdflatex -interaction=nonstopmode -halt-on-error -output-directory=/tmp /tmp/preamble.tex >/dev/null \
    && rm -f /tmp/preamble.*

COPY --from=build /app/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=build /app/dist ${LAMBDA_TASK_ROOT}/dist
COPY migrations ${LAMBDA_TASK_ROOT}/migrations
COPY --from=build /app/package.json ${LAMBDA_TASK_ROOT}/package.json

CMD ["dist/lambda.handler"]
